<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:PhotoComp.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PhotoComp.Views.CompareDialog"
        Icon="/Assets/app-icon.ico"
        Title="Compare Images — PhotoComp"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        Focusable="True">

    <Window.Resources>
        <conv:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
    </Window.Resources>

    <DockPanel>
        <!-- Header Bar -->
        <Border DockPanel.Dock="Top"
                Background="#222222"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                <!-- Left Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="↔ Compare Images" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Filenames -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="#88C0D0">
                        <Run Text="Left: " FontWeight="SemiBold"/>
                        <Run x:Name="LeftFileNameText" Text="Image 1"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#555555">│</TextBlock>
                    <TextBlock FontSize="13" Foreground="#EBCB8B">
                        <Run Text="Right: " FontWeight="SemiBold"/>
                        <Run x:Name="RightFileNameText" Text="Image 2"/>
                    </TextBlock>
                </StackPanel>

                <!-- Close Button & Hint -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Double-click to zoom, drag to pan  •  ESC to close" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton" Content="🗙 Close" Padding="10,4" Background="#333333" Foreground="White" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Control Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#222222"
                BorderBrush="#333333"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SwapButton" Content="⇄ Swap Left / Right" Padding="8,4" ToolTip.Tip="Swap left and right images"/>
                    <Button x:Name="ResetSplitButton" Content="50%" Padding="8,4" ToolTip.Tip="Reset divider to center (50%)"/>
                </StackPanel>

                <!-- Slider -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <TextBlock Text="100% Left" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                    <Slider x:Name="SplitSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center"/>
                    <TextBlock Text="100% Right" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Grid.Column="2" x:Name="PercentText" Text="Split: 50%" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center" Width="170" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Main Image Comparison Area -->
        <Grid x:Name="ImageContainer" Background="#0A0A0A" ClipToBounds="True">
            <!-- Layer 1: Right Image (Bottom layer) -->
            <Image x:Name="RightImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0,0"/>

            <!-- Layer 2: Left Image (Top layer). Wrapped so the clip rect is expressed
                 in ImageContainer's coordinate space rather than the (possibly letterboxed
                 and centered) Image element's own bounds. -->
            <Grid x:Name="LeftImageClip" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image x:Name="LeftImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0,0"/>
            </Grid>

            <!-- Layer 3: Divider Line & Drag Handle. Hit-testable (unlike the rest of the
                 image area) so it can always be grabbed to reposition the split, even
                 while zoomed in and panning elsewhere in the image area. -->
            <Grid x:Name="DividerLine"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Stretch"
                  Width="20"
                  Margin="-10,0,0,0"
                  Background="Transparent"
                  Cursor="SizeWestEast">
                <!-- Vertical Line -->
                <Border Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#FFFFFF" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" Color="Black" OffsetX="0" OffsetY="0" Opacity="0.8"/>
                    </Border.Effect>
                </Border>

                <!-- Center Drag Handle Pill -->
                <Border x:Name="DividerHandle" Width="36" Height="36" CornerRadius="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#DD222222" BorderBrush="#FFFFFF" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Color="Black" OffsetX="0" OffsetY="2" Opacity="0.6"/>
                    </Border.Effect>
                    <TextBlock Text="◄ ►" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>