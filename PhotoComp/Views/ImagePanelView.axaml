<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoComp.ViewModels"
             xmlns:conv="using:PhotoComp.Converters"
             xmlns:models="using:PhotoComp.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="PhotoComp.Views.ImagePanelView"
             x:DataType="vm:ImagePanelViewModel"
             Focusable="True">

    <UserControl.Resources>
        <conv:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
        <conv:XmlFormatterConverter x:Key="XmlFormatterConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- When the heart is active, colour its glyph red. -->
        <Style Selector="TextBlock.hearted">
            <Setter Property="Foreground" Value="#FF6B6B"/>
        </Style>

        <!--
            Override Fluent theme's default button hover/press styles.
            Without these, the ContentPresenter background goes solid black on hover,
            making the glyph (white text on transparent button) invisible.
            We swap it for a subtle white tint instead, keeping the dark pill visible.
        -->
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:ImagePanelViewModel/>
    </Design.DataContext>

    <Grid>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Copy Image to Clipboard"
                          Command="{Binding CopyToClipboardCommand}"
                          InputGesture="Ctrl+C"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Dark background + clipped image area -->
        <Border Background="#1A1A1A" ClipToBounds="True">
            <Image x:Name="MainImage"
                   Source="{Binding CurrentImage.FilePath, Converter={StaticResource StringToBitmapConverter}}"
                   Stretch="Uniform"
                   RenderTransformOrigin="0,0"/>
        </Border>

        <!-- Left navigation button — dark pill ensures visibility over any image content -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                Background="#CC000000" CornerRadius="4" Margin="6,0">
            <Button Command="{Binding NavigatePreviousCommand}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="White" Padding="10,8"
                    ToolTip.Tip="Previous (←)">◄</Button>
        </Border>

        <!-- Right navigation button -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="#CC000000" CornerRadius="4" Margin="6,0">
            <Button Command="{Binding NavigateNextCommand}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="White" Padding="10,8"
                    ToolTip.Tip="Next (→)">►</Button>
        </Border>

        <!-- Top-right overlay: AI Critic + Heart buttons -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                    Orientation="Horizontal" Spacing="4" Margin="0,6,8,0">

            <Border Background="#CC000000" CornerRadius="4">
                <Button Command="{Binding ShowAiCriticCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White" Padding="8,4" FontSize="13"
                        ToolTip.Tip="AI Critic — analyze this image">🔍 Critic</Button>
            </Border>

            <Border Background="#CC000000" CornerRadius="4">
                <Button Command="{Binding ToggleHeartCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White" Padding="8,4" FontSize="22"
                        ToolTip.Tip="Toggle favourite">
                    <TextBlock Text="{Binding HeartGlyph}"
                               Classes.hearted="{Binding IsCurrentHearted}"/>
                </Button>
            </Border>

        </StackPanel>

        <!-- Delete button (top-left) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#CC000000" CornerRadius="4" Margin="8,6,0,0">
            <Button Command="{Binding DeleteCurrentCommand}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#FF8080" Padding="8,4" FontSize="18"
                    ToolTip.Tip="Delete image (Del)">🗑</Button>
        </Border>

        <!-- Info overlay (bottom-left): dimensions and date/time; click to expand EXIF details -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="0">

            <!-- EXIF detail overlay — visible when toggled, grows upward above the info bar -->
            <Border Background="#E8000000" CornerRadius="0,4,0,0"
                    IsVisible="{Binding IsExifVisible}"
                    MaxHeight="280" MaxWidth="360" Padding="10,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ExifDetailRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ExifRow">
                                <Grid ColumnDefinitions="100,*" Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               Foreground="#AAAAAA" FontSize="11"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               Foreground="White" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Info bar (always visible when image is loaded) -->
            <Button Command="{Binding ToggleExifOverlayCommand}"
                    Background="#CC000000" CornerRadius="0,4,0,0"
                    BorderThickness="0" Padding="0"
                    IsEnabled="{Binding ExifDetailRows,
                                Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="Click to show/hide EXIF details"
                    IsVisible="{Binding InfoText,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding InfoText}"
                           Foreground="White" FontSize="11"
                           Margin="6,3"/>
            </Button>

        </StackPanel>

        <!-- SD prompt overlay (bottom-right): visible only when prompt metadata exists -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#CC000000" CornerRadius="4,0,0,0"
                MaxWidth="420"
                IsVisible="{Binding PromptText,
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                ToolTip.Tip="{Binding PromptText, Converter={StaticResource XmlFormatterConverter}}">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Prompt"
                              Command="{Binding CopyPromptCommand}"/>
                </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="{Binding PromptText}"
                       Foreground="White" FontSize="10"
                       TextWrapping="Wrap" MaxLines="3"
                       TextTrimming="CharacterEllipsis"
                       Margin="6,4"/>
        </Border>

    </Grid>
</UserControl>
