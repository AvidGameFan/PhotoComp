<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoComp.ViewModels"
        xmlns:v="using:PhotoComp.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PhotoComp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="PhotoComp"
        MinWidth="600" MinHeight="400"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!--
            Override Fluent theme's default button hover/press styles for the
            dark-pill overlay buttons (top-center browse/push, etc.).
            These buttons sit outside ImagePanelView's UserControl scope, so
            ImagePanelView's identical style doesn't reach them.
        -->
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <!-- Root Grid lets us layer the loading overlay on top of the DockPanel -->
    <Grid>

    <DockPanel>

        <!-- ── Toolbar ─────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ClipToBounds="True">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">

                <Button Command="{Binding LoadFolderCommand}"
                        ToolTip.Tip="Open a folder of images">
                    📁  Open Folder
                </Button>

                <Separator/>

                <Button Command="{Binding CopySelectedCommand}"
                        IsEnabled="{Binding HasSelections}"
                        ToolTip.Tip="Copy selected images to another folder">
                    <TextBlock>
                        <Run Text="💾  Copy Selected ("/>
                        <Run Text="{Binding SelectedCount}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </Button>

                <Button Command="{Binding MoveSelectedCommand}"
                        IsEnabled="{Binding HasSelections}"
                        ToolTip.Tip="Move selected images to another folder (files are removed from source)">
                    <TextBlock>
                        <Run Text="📦  Move Selected ("/>
                        <Run Text="{Binding SelectedCount}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </Button>

                <Separator/>

                <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="12">
                    <Run Text="Zoom: "/>
                    <Run Text="{Binding SharedZoom.Scale, StringFormat={}{0:P0}}"/>
                </TextBlock>

                <Button Command="{Binding ResetZoomCommand}"
                        Padding="6,4"
                        ToolTip.Tip="Reset zoom to 100%">
                    ⊙ Reset Zoom
                </Button>

                <Separator/>

                <Button Command="{Binding ToggleSingleViewCommand}"
                        Padding="6,4"
                        ToolTip.Tip="Toggle between single-panel and dual-panel view">
                    <TextBlock Text="{Binding SingleViewButtonLabel}"/>
                </Button>

                <Separator/>

                    <Button Command="{Binding ToggleFilmstripCommand}"
                            Padding="6,4"
                            ToolTip.Tip="Toggle filmstrip">
                        🎞 Filmstrip
                    </Button>

                <Separator/>

                <Button x:Name="AiCriticSettingsButton"
                        Padding="6,4"
                        ToolTip.Tip="AI Critic Settings — configure API URL, key and model">
                    ⚙ AI Critic
                </Button>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           MinWidth="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding CurrentFolder}"
                           IsVisible="{Binding CurrentFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           ToolTip.Tip="{Binding CurrentFolder}"/>

            </Grid>
        </Border>

        <!-- ── Status bar ──────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12">
                    <TextBlock FontSize="11">
                        <Run Text="Left: "/>
                        <Run Text="{Binding LeftPanel.PositionLabel}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Opacity="0.4">│</TextBlock>
                    <TextBlock FontSize="11">
                        <Run Text="Right: "/>
                        <Run Text="{Binding RightPanel.PositionLabel}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Opacity="0.4">│</TextBlock>
                    <TextBlock FontSize="11">
                        <Run Text="Selected: "/>
                        <Run Text="{Binding SelectedCount}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- ── Filmstrip ─────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding IsFilmstripVisible}"
                Background="#1A1A1A"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Height="116">
            <Border.Styles>
                <Style Selector="Border.film-cell">
                    <Setter Property="Background"      Value="#2A2A2A"/>
                    <Setter Property="BorderBrush"     Value="#444444"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Style>
                <Style Selector="Border.film-cell:pointerover">
                    <Setter Property="Background"  Value="#383838"/>
                    <Setter Property="BorderBrush" Value="#888888"/>
                </Style>
                <Style Selector="Border.film-cell.current">
                    <Setter Property="BorderBrush" Value="#4A9FC7"/>
                </Style>
            </Border.Styles>
            <ScrollViewer x:Name="FilmstripScroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FilmstripList"
                              ItemsSource="{Binding FilmstripItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThumbnailItemViewModel">
                            <Border Classes="film-cell"
                                    Classes.current="{Binding IsCurrentImage}"
                                    Width="84" Height="84"
                                    CornerRadius="3"
                                    Margin="3,0"
                                    Cursor="Hand"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    <TextBlock Text="&#x2665;"
                                               IsVisible="{Binding IsHearted}"
                                               Foreground="#FF4444"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Margin="0,2,4,0"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <!-- ── Two image panels ────────────────────────────────────── -->
        <Grid x:Name="PanelsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Panel x:Name="LeftPanelContainer" Grid.Column="0">
                <v:ImagePanelView DataContext="{Binding LeftPanel}"/>
                <TextBlock IsVisible="{Binding LeftPanel, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="Open a folder to begin."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White"/>
                <!-- Browse + push-right buttons (top-center); push arrow hidden in single view -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="#CC000000" CornerRadius="4" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding LeftPanel.ShowPickerCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" Padding="8,4" FontSize="15"
                                ToolTip.Tip="Browse all images (thumbnail picker)">⊞</Button>
                        <Button IsVisible="{Binding IsDualView}"
                                Command="{Binding PushLeftToRightCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" Padding="10,4" FontSize="14"
                                ToolTip.Tip="Show this image in the right panel">→</Button>
                    </StackPanel>
                </Border>
                <!-- Active-panel indicator: blue line across the top -->
                <Border Height="3" Background="#4A9FC7"
                        VerticalAlignment="Top"
                        IsVisible="{Binding IsLeftPanelActive}"
                        IsHitTestVisible="False"/>
            </Panel>

            <!-- Fixed divider (non-draggable) -->
            <Border Grid.Column="1"
                    IsVisible="{Binding IsDualView}"
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

            <!-- Right panel -->
            <Panel x:Name="RightPanelContainer" Grid.Column="2" IsVisible="{Binding IsDualView}">
                <v:ImagePanelView DataContext="{Binding RightPanel}"/>
                <TextBlock IsVisible="{Binding RightPanel, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="Open a folder to begin."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White"/>
                <!-- Push-left + browse buttons (top-center) -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="#CC000000" CornerRadius="4" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding PushRightToLeftCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" Padding="10,4" FontSize="14"
                                ToolTip.Tip="Show this image in the left panel">←</Button>
                        <Button Command="{Binding RightPanel.ShowPickerCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" Padding="8,4" FontSize="15"
                                ToolTip.Tip="Browse all images (thumbnail picker)">⊞</Button>
                    </StackPanel>
                </Border>
                <!-- Active-panel indicator: blue line across the top -->
                <Border Height="3" Background="#4A9FC7"
                        VerticalAlignment="Top"
                        IsVisible="{Binding IsRightPanelActive}"
                        IsHitTestVisible="False"/>
            </Panel>

        </Grid>

    </DockPanel>

    <!-- Loading overlay — dims the window and shows a wait cursor while images are scanned -->
    <Border IsVisible="{Binding IsLoading}"
            Background="#66000000"
            IsHitTestVisible="True"
            Cursor="Wait">
        <TextBlock Text="Loading…"
                   Foreground="White" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    </Grid>

</Window>
